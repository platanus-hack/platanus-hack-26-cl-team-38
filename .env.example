# Copy to .env.local. Local values come from `pnpm dlx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: bypasses RLS.
SUPABASE_SECRET_KEY=

ANTHROPIC_API_KEY=
# Planes: "1" lets the orchestrator search the web for what is still open (experiment).
PLANS_WEB_SEARCH=
# Privacy judge: "haiku" (default, faster) or "opus" (stricter and stable between runs).
PRIVACY_JUDGE_MODEL=haiku
# Signs the MCP connector's OAuth tokens (32+ characters, e.g. `openssl rand -hex 32`). Without it
# every restart signs with a new key and connected assistants have to authorize again.
MCP_OAUTH_SECRET=
SPOTIFY_CLIENT_ID=
# Google connector (Takeout export picked from Drive): a "Web application" OAuth client whose
# redirect URI is <origin>/api/google/callback. Without both, the Google row answers 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Embeddings run locally with transformers.js (src/lib/embeddings.ts): no key needed.
